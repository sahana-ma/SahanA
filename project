    "from pyspark.ml.feature import StringIndexer\n",
    "\n",
    "# Convert categorical to numeric\n",
    "indexer1 = StringIndexer(inputCol=\"Gender\", outputCol=\"Gender_Index\")\n",
    "indexer2 = StringIndexer(inputCol=\"Married\", outputCol=\"Married_Index\")\n",
    "indexer3 = StringIndexer(inputCol=\"Education\", outputCol=\"Education_Index\")\n",
    "indexer4 = StringIndexer(inputCol=\"Self_Employed\", outputCol=\"Self_Employed_Index\")\n",
    "indexer5 = StringIndexer(inputCol=\"Property_Area\", outputCol=\"Property_Area_Index\")\n",
    "indexer6 = StringIndexer(inputCol=\"Loan_Status\", outputCol=\"Label\")\n",
    "\n",
    "df = indexer1.fit(df).transform(df)\n",
